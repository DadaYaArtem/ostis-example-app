{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/problem-solver/cxx/**",
                "${workspaceFolder}/.conan2/sc-machine-headers/sc-memory/sc-memory/include",
                "${workspaceFolder}/.conan2/sc-machine-headers/scl-machine/problem-solver",
